@implements IDisposable
@inject NavigationManager NavigationManager
<div class="brand"><a href="">◈ StockFlow</a><small>INVENTARIO &amp; VENTAS</small></div>
<nav class="stock-nav">
    <NavLink href="" Match="NavLinkMatch.All">▦ Dashboard</NavLink>
    <NavLink href="productos">□ Productos</NavLink>
    <NavLink href="categorias">▤ Categorías</NavLink>
    <NavLink href="pedidos">↗ Pedidos</NavLink>
    <NavLink href="movimientos">⇄ Movimientos</NavLink>
    <NavLink href="reportes">▥ Reportes</NavLink>
    <AuthorizeView Roles="Admin"><NavLink href="usuarios">○ Usuarios</NavLink></AuthorizeView>
    <div class="nav-divider"></div>
    <AuthorizeView>
        <Authorized>
            <NavLink href="Account/Manage">@context.User.Identity?.Name</NavLink>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken /><input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <button type="submit">Cerrar sesión</button>
            </form>
        </Authorized>
        <NotAuthorized><NavLink href="Account/Login">Ingresar</NavLink><NavLink href="Account/Register">Crear cuenta</NavLink></NotAuthorized>
    </AuthorizeView>
</nav>
@code {
    private string? currentUrl;
    protected override void OnInitialized() { currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri); NavigationManager.LocationChanged += Changed; }
    private void Changed(object? sender, LocationChangedEventArgs e) { currentUrl = NavigationManager.ToBaseRelativePath(e.Location); StateHasChanged(); }
    public void Dispose() => NavigationManager.LocationChanged -= Changed;
}
